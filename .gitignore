# Secrets
.env

# Data (don't commit PDFs you may not have redistribution rights to, or the vector DB)
data/documents/*.pdf
data/chroma_db/

# Results (regenerable — commit a sample comparison_table.csv manually if you want one in the repo)
results/*.csv

# Python
__pycache__/
*.pyc
venv/
.venv/

# Streamlit
.streamlit/

# OS
.DS_Store

# Ignore everything inside the results directory
results/*

# But do NOT ignore the .gitkeep file inside results
!results/.gitkeep